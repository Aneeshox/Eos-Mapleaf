    LeadingEdge{
        shape         Round # Blunt or Round (Even sharp edges always have a small radius)
        #thickness     0.00931 # Used for 'Blunt' edge
        radius        0.007239 # Used for 'Round' edge
    }

    TrailingEdge{
        shape         Round # Tapered (0 base drag), Round (1/2 base drag), Blunt (full base drag)
        #thickness     0.001 # Used for 'Blunt' edge
        radius        0.007239 # Used for 'Round' edge
    }
	}

HybridMotor{
        class           Hybrid
			staticFirePath		C:\Users\taiya\miniconda3\envs\SOAR2\Lib\site-packages\MAPLEAF\Aneeshox\StaticFire\AegisStaticFire1.txt

		    OFRatio              6.6        # Oxidizer/Fuel mass ratio
			oxidizerFlowRate     1.68       # kg/s (constant, see note in original script)
			extension            1          # + 5s || >0 lengthens burn, <0 shortens it, 0 = no change (s)
			estimation           True       # Scale thrust curve so its mean == estimationAvgThrust
			estimationAvgThrust  2959.16    # N, target mean thrust (e.g. from NASA CEA)
			totalOxMass         10.0       # kg, used only for oxidizer MOI magnitude
			totalFuelMass        2.2        # kg, used only for fuel MOI magnitude

			# --- Pressure-vessel (oxidizer tank) geometry, meters ---
			diamOfPressureVessel   0.167
			lengthOfPressureVessel 0.813

			# --- Fuel grain geometry, meters ---
			lengthOfFuelGrain  0.29
			outerDiamFuelGrain 0.165
			innerDiamFuelGrain 0.10

			# --- Propellant CG locations (m, rocket Z-coordinates), written into the file header ---
			burnedOxidizerInitialCG -2.77796
			burnedOxidizerLastCG    -2.52796
			burnedFuelInitialCG     -3.64796
			burnedFuelLastCG        -3.64796
}
}
